{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SmartWP Plugins Documentation",
  "colors": {
    "primary": "#0353a6",
    "light": "#007dff",
    "dark": "#007dff"
  },
  "favicon": {
    "light": "/images/FAVICON_COLOR.svg",
    "dark": "/images/FAVICON_WHITE.svg"
  },
  "navigation": {
    "products": [
      {
        "product": "Unwan",
        "pages": [
          "unwan/introduction",
          "unwan/installation",
          "unwan/quickstart",
          "unwan/my-account",
          "unwan/settings",
          {
            "group": "Checkout",
            "pages": [
              "unwan/checkout/checkout-blocks",
              "unwan/checkout/checkout-overview",
              "unwan/checkout/classic-checkout"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "unwan/concepts/address-book-model",
              "unwan/concepts/default-swaps-and-duplicates"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "unwan/customization/appearance-and-theming",
              "unwan/customization/css-and-markup"
            ]
          },
          {
            "group": "Developers",
            "pages": [
              "unwan/developers/architecture",
              "unwan/developers/hooks-reference",
              "unwan/developers/javascript-api"
            ]
          },
          "unwan/faq",
          "unwan/changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/LOGO_COLOR.svg",
    "dark": "/images/LOGO_WHITE.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@smartwpplugins.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Smart-WP-Plugins"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "metadata": {
    "timestamp": false
  },
  "thumbnails": {
    "fonts": {
      "family": "Inter"
    }
  },
  "interaction": {
    "drilldown": true
  },
  "redirects": [
    {
      "source": "/addrvault/:slug*",
      "destination": "/unwan/:slug*",
      "permanent": true
    },
    {
      "source": "/addrvault",
      "destination": "/unwan",
      "permanent": true
    }
  ]
}
